# Copy to .env.local.
# Docker Postgres from docker-compose.yml (these credentials are local-only, not secrets):
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/movie_memory"

# Auth.js: generate with `npx auth secret` or `openssl rand -base64 32`
AUTH_SECRET="replace-me"
AUTH_GOOGLE_ID="replace-me.apps.googleusercontent.com"
AUTH_GOOGLE_SECRET="replace-me"

OPENAI_API_KEY="sk-replace-me"
OPENAI_MODEL="gpt-6-luna"
